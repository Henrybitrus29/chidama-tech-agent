# Copy to .env for local use. Never commit .env.
TENANT=brightside-solar              # folder under knowledge/
GROQ_API_KEY=                        # free key from console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# Security
ALLOWED_ORIGINS=http://localhost:5500,https://your-site.vercel.app   # comma separated; empty = same-origin only
ADMIN_TOKEN=                         # openssl rand -hex 24 ; leave empty to disable /api/admin/*
TRUSTED_PROXY_HOPS=1                 # proxies that append to X-Forwarded-For; the real client is the Nth entry from the right
RATE_LIMIT_IP_PER_DAY=150            # per IP, rolling 24 h
DAILY_TURN_CAP=600                   # all visitors together, rolling 24 h; keep below your Groq daily limit
TRUST_PROXY=true                     # true behind Render/Fly/Nginx so rate limits see the real client IP

# Persistence (memory is lost on restart; free MongoDB Atlas keeps data)
STORE=memory
MONGO_URI=
MONGO_DB=concierge

# Optional integrations
LEAD_WEBHOOK_URL=                    # your LeadFlow n8n webhook: https://HOST/webhook/lead-intake
LEAD_WEBHOOK_TOKEN=                  # the public X-Form-Token your LeadFlow webhook expects
NOTIFY_WEBHOOK_URL=                  # Discord webhook for handoffs, leads and bookings
BOOKING_WEBHOOK_URL=
